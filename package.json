  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.28.0",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@eslint/js": "^9.39.0",
    "@servicenow/eslint-plugin-aiux-a11y": "0.4.0",
    "@servicenow/eslint-plugin-aiux-app": "0.5.0",
    "@servicenow/eslint-plugin-aiux-i18n": "0.2.0",
    "@servicenow/eslint-plugin-aiux-ssr": "1.3.0",
    "@servicenow/eslint-plugin-aiux-style": "0.4.0",
    "@servicenow/agent-pack-aiux": "2.6.0",
    "@servicenow/agent-pack-horizon-design-knowledge": "2.0.0",
